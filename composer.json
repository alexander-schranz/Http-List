{
    "name": "cmsig/http-list",
    "description": "Lists of common query parameters and cookies of different tools.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-cs-fixer/shim": "^3.51",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.3 || ^11.0",
        "psr/http-message": "^1.0 || ^2.0",
        "rector/rector": "^2.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "conflict": {
        "psr/http-message": "<1.0 || >=3.0",
        "symfony/http-foundation": "<5.4 || >=9.0"
    },
    "suggest": {
        "psr/http-message": "To strip PSR-7 requests via CmsIg\\HttpList\\Psr7\\Psr7RequestStripper",
        "symfony/http-foundation": "To strip Symfony requests via CmsIg\\HttpList\\HttpFoundation\\HttpFoundationRequestStripper"
    },
    "autoload": {
        "psr-4": {
            "CmsIg\\HttpList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CmsIg\\HttpList\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "@php vendor/bin/phpstan analyze",
        "lint-rector": "@php vendor/bin/rector process --dry-run",
        "lint-php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "lint-composer": "@composer validate --strict",
        "lint": [
            "@phpstan",
            "@lint-php-cs",
            "@lint-rector",
            "@lint-composer"
        ],
        "rector": "@php vendor/bin/rector process",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fix"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
